# Base de datos PostgreSQL (Neon u otro proveedor)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secreto JWT — obligatorio en producción
JWT_SECRET="cambiar-por-secreto-seguro-en-produccion"

# Puerto local
PORT=3001

# URL del frontend (para CORS en producción)
# FRONTEND_URL="https://portal-requerimientos.vercel.app"

# Contraseñas del seed (opcional, solo primer arranque)
# SEED_ADMIN_PASSWORD="Admin2026!"
# SEED_DEFAULT_PASSWORD="Sopraval2026"
